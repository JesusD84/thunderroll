# Database
# La contraseña del Postgres local se define aquí y la lee docker-compose.
# `change-me` es un placeholder: cámbiala por una tuya.
POSTGRES_USER=thunderoll
POSTGRES_DB=thunderoll
POSTGRES_PASSWORD=change-me
# Obligatoria: sin DATABASE_URL el backend NO arranca.
DATABASE_URL=postgresql://thunderoll:change-me@localhost:5432/thunderoll

# Auth (JWT)
# Obligatoria y sin valor de respaldo: debe ser un valor ALEATORIO de 32
# caracteres o más. Genera una con:
#
#   openssl rand -hex 32
#
# Si falta o es más corta, el backend NO arranca y lo dice con un error claro.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=540

# Password inicial del admin bootstrap (solo para una base vacía).
# Si se deja vacío, el seed genera una aleatoria y la imprime en el log.
BOOTSTRAP_ADMIN_PASSWORD=

# CORS / links
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Importación de archivos (opcionales: estos son los valores por defecto)
# Tamaño máximo por archivo, en MB.
MAX_UPLOAD_SIZE_MB=10
# Máximo de filas de datos por hoja.
MAX_IMPORT_ROWS_PER_SHEET=20000
# Máximo de hojas por archivo.
MAX_IMPORT_SHEETS=50
# Dónde se guardan los archivos subidos. NO es una ruta servida por la API.
# Si no se define, se usa <backend>/var/imports.
# IMPORT_STORAGE_DIR=/app/var/imports

# Mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://backend:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
